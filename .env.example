MAIL_HOST=smtp.qq.com
MAIL_PORT=587
MAIL_USERNAME=your-account@qq.com
MAIL_PASSWORD=your-smtp-authorize-code
MAIL_AUTH=true
MAIL_SSL=false
MAIL_STARTTLS=true
MAIL_TIMEOUT=5000
MAIL_CONNECTION_TIMEOUT=5000

# QQ mail alternative:
# 465 requires implicit SSL, not STARTTLS.
# MAIL_PORT=465
# MAIL_SSL=true
# MAIL_STARTTLS=false

DB_HOST=localhost
DB_PORT=3306
DB_NAME=nexus_db
DB_USERNAME=root
DB_PASSWORD=password

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

ES_URIS=http://localhost:9200

JWT_SECRET=replace-with-a-strong-secret
GITHUB_TOKEN=replace-with-a-token-if-needed
GITHUB_OAUTH_CLIENT_ID=replace-with-client-id
GITHUB_OAUTH_CLIENT_SECRET=replace-with-client-secret
ADMIN_PASSWORD=replace-with-admin-password
